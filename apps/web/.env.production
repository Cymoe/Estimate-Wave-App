# Public Convex deployment URL used by `vite build` (Vercel previews and
# production) when no VITE_CONVEX_URL is set in the hosting environment.
# It is not a secret: the browser needs it to reach the backend. A value set
# in Vercel's environment variables takes precedence over this file.
VITE_CONVEX_URL=https://basic-owl-573.convex.cloud
