# Convex deployment URL. `npx convex dev` writes this (and CONVEX_DEPLOYMENT)
# to .env.local for you. In Vercel, set it to the production deployment URL.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Set these on the Convex deployment (dashboard > Settings > Environment
# Variables, or `npx convex env set NAME value`), not in this file:
#   SITE_URL             e.g. http://localhost:3000 or https://your-app.vercel.app
#   JWT_PRIVATE_KEY, JWKS  generated by `npx @convex-dev/auth`
#   AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET  for "Sign in with Google"
